        <dt>
            @Html.DisplayNameFor(model => model.foto)
        </dt>
        <dd>
            @* Mostramos la imagen usando la ruta guardada en la base de datos *@
            <img src="@Url.Content(Model.foto)" width="150" height="150" />
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.id }) |
