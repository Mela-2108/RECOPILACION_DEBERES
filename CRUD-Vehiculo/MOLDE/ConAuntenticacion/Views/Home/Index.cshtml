@{
    ViewBag.Title = "Página Principal";
}

<main class="py-4">

    <section class="p-4 mb-4 rounded-3 text-center shadow-sm" style="background-color: #fde8ed; border: 1px solid #f8b6c8;">
        <h1 class="display-5 fw-bold" style="color: #d63384;">Portal Académico</h1>
        <p class="lead text-dark">Sistema de Gestión y Presentación del Proyecto Integrador</p>
    </section>


    <div class="row g-4">

        <section class="col-md-4">
            <div class="card h-100 shadow-sm" style="border: 1px solid #f8b6c8;">
                <div class="card-header text-white fw-bold text-center" style="background-color: #e83e8c;">
                    Información Completa
                </div>
                <div class="card-body">
                    <h5 class="card-title fw-bold" style="color: #d63384;">Melany</h5>
                    <p class="card-text text-muted">Estudiante de Ingeniería  Tecnologias de la Informacion y Comunicación </p>
                    <hr style="color: #f8b6c8;" />
                    <ul class="list-unstyled">
                        <li class="mb-2"><strong>Carrera:</strong> Ingeniería en TICs</li>
                        <li class="mb-2"><strong>Nivel / Semestre:</strong> 6to Semestre</li>
                        <li class="mb-2"><strong>Correo Electrónico:</strong> mela@hotmail.com</li>
                        <li class="mb-2"><strong>Perfil:</strong> Desarrollo Web ASP.NET MVC, C#, Bases de Datos SQL Server</li>
                    </ul>
                </div>
            </div>
        </section>


        <section class="col-md-4">
            <div class="card h-100 shadow-sm text-center" style="border: 2px solid #e83e8c;">
                <div class="card-body d-flex flex-column align-items-center justify-content-center">

                    <img src="~/imagenes/mela.png" alt="Foto de Melany"
                         class="rounded-circle img-thumbnail mb-3"
                         style="width: 140px; height: 140px; object-fit: cover; border-color: #e83e8c;"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/140';" />

                    <h4 class="card-title fw-bold" style="color: #d63384;">Melany</h4>
                    <span class="badge mb-2" style="background-color: #e83e8c;">Desarrollador Principal</span>
                    <p class="card-text text-secondary mt-2">
                        Estudiante de Sistemas apasionado por el desarrollo de software y las redes de comunicación.
                    </p>
                </div>
            </div>
        </section>


        <section class="col-md-4">
            <div class="card h-100 shadow-sm" style="border: 1px solid #f8b6c8;">
                <div class="card-header text-white fw-bold text-center" style="background-color: #e83e8c;">
                    Datos Académicos
                </div>
                <div class="card-body">
                    <h5 class="card-title fw-bold" style="color: #d63384;">Universidad</h5>
                    <p class="card-text mb-1"><strong>Institución:</strong> Universidad de las fuerzas Armadas ESPE </p>
                    <p class="card-text mb-3"><strong>Facultad:</strong> Ingeniería y Ciencias Aplicadas</p>
                    <hr style="color: #f8b6c8;" />
                    <h5 class="card-title fw-bold" style="color: #d63384;">Materia</h5>
                    <p class="card-text mb-1"><strong>Asignatura:</strong> Desarrollo Web para Integracion de Tecnologías</p>
                    <p class="card-text mb-1"><strong>Docente:</strong> Ing. Juan Fernando Galarraga</p>
                    <p class="card-text"><strong>Periodo Académico:</strong> 2026</p>
                </div>
            </div>
        </section>
    </div>
</main>