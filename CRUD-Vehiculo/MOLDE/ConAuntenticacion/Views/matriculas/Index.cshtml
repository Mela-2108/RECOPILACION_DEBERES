@model IEnumerable<ConAuntenticacion.Models.matricula>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.fecha)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.anio)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.agencia1.descripcion)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.vehiculo1.placa)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @* Verificamos si la fecha tiene valor antes de aplicarle el formato en texto *@
                @(item.fecha.HasValue ? item.fecha.Value.ToString("dd '–' MMMM '–' yyyy", new System.Globalization.CultureInfo("es-ES")) : "Sin fecha")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.anio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.agencia1.descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.vehiculo1.placa)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.id }) |
                @Html.ActionLink("Details", "Details", new { id = item.id }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.id })
            </td>
        </tr>
    }
</table>