<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="PacienteDB_FotoModelStoreContainer" CdmEntityContainer="PacienteDB_FotoEntities">
    <EntitySetMapping Name="Consultas">
      <EntityTypeMapping TypeName="PacienteDB_FotoModel.Consulta">
        <MappingFragment StoreEntitySet="Consulta">
          <ScalarProperty Name="codigoConsulta" ColumnName="codigoConsulta" />
          <ScalarProperty Name="fecha" ColumnName="fecha" />
          <ScalarProperty Name="horaInicio" ColumnName="horaInicio" />
          <ScalarProperty Name="horaFin" ColumnName="horaFin" />
          <ScalarProperty Name="codPaciente" ColumnName="codPaciente" />
          <ScalarProperty Name="codMedico" ColumnName="codMedico" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Medicos">
      <EntityTypeMapping TypeName="PacienteDB_FotoModel.Medico">
        <MappingFragment StoreEntitySet="Medico">
          <ScalarProperty Name="codMedico" ColumnName="codMedico" />
          <ScalarProperty Name="nombre" ColumnName="nombre" />
          <ScalarProperty Name="horaInicio" ColumnName="horaInicio" />
          <ScalarProperty Name="horaFin" ColumnName="horaFin" />
          <ScalarProperty Name="codEspecialidad" ColumnName="codEspecialidad" />
          <ScalarProperty Name="codClinica" ColumnName="codClinica" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Pacientes">
      <EntityTypeMapping TypeName="PacienteDB_FotoModel.Paciente">
        <MappingFragment StoreEntitySet="Paciente">
          <ScalarProperty Name="codPaciente" ColumnName="codPaciente" />
          <ScalarProperty Name="cedula" ColumnName="cedula" />
          <ScalarProperty Name="nombre" ColumnName="nombre" />
          <ScalarProperty Name="fechaNacimiento" ColumnName="fechaNacimiento" />
          <ScalarProperty Name="peso" ColumnName="peso" />
          <ScalarProperty Name="altura" ColumnName="altura" />
          <ScalarProperty Name="foto" ColumnName="foto" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>