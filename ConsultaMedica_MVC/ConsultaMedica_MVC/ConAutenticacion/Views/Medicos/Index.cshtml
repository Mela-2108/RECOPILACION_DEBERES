@model IEnumerable<ConAutenticacion.Models.Medico>

@{
    ViewBag.Title = "Listado de Médicos";
}

<h2>Listado de Médicos</h2>

<p>
    @Html.ActionLink("Crear Nuevo", "Create")
</p>
<table class="table">
    <tr>
        <th>Nombre Médico</th>
        <th>Especialidad</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.codEspecialidad)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.codMedico }) |
                @Html.ActionLink("Details", "Details", new { id = item.codMedico }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.codMedico })
            </td>
        </tr>
    }

</table>
